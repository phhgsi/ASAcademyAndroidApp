<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- 1. Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@color/bg_card"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBackAddStudent"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Official Student Admission"
                android:textColor="@color/text_light"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Registration &amp; Dakhil Kharij Record"
                android:textColor="@color/accent_sky"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTopSave"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="💾 Save"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_primary"
            android:paddingHorizontal="14dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- WING & AUTO SCHOLAR GENERATOR CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Auto Scholar Number Generator"
                    android:textColor="@color/accent_gold"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Wing Switcher Pills -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnWingP"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="🎒 Primary Wing (P)"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_chip_selected"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/btnWingS"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="🎓 High School Wing (S)"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_glass_pill_unselected" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvScholarSuggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next available: P..."
                    android:textColor="@color/accent_sky"
                    android:textSize="11sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- SECTION 1: Academic & Identification -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Academic &amp; Identification"
                android:textColor="@color/accent_sky"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="12dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scholar Number (दाखिल खारिज क्र.) *"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etAddScholar"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:hint="Type 'p' or 's' for auto-assign"
                    android:textColor="@color/text_light"
                    android:textColorHint="@color/text_muted"
                    android:background="#071224"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admission Class *"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spAddClass"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="#071224"
                    android:paddingHorizontal="10dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Admission Date"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnAdmissionDate"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:gravity="center_vertical"
                            android:text="2026-08-28 📅"
                            android:textColor="@color/text_light"
                            android:background="#071224"
                            android:paddingHorizontal="10dp"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Roll Number"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etAddRollNumber"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:hint="e.g. 01"
                            android:inputType="number"
                            android:textColor="@color/text_light"
                            android:textColorHint="@color/text_muted"
                            android:background="#071224"
                            android:paddingHorizontal="10dp"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- SECTION 2: Student Personal Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Student Personal Information"
                android:textColor="@color/accent_sky"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="12dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="First Name (English) *"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etAddFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:hint="e.g. Rahul"
                    android:textColor="@color/text_light"
                    android:textColorHint="@color/text_muted"
                    android:background="#071224"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Middle Name"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etAddMiddleName"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:hint="Kumar"
                            android:textColor="@color/text_light"
                            android:textColorHint="@color/text_muted"
                            android:background="#071224"
                            android:paddingHorizontal="10dp"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last Name"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etAddLastName"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:hint="Sharma"
                            android:textColor="@color/text_light"
                            android:textColorHint="@color/text_muted"
                            android:background="#071224"
                            android:paddingHorizontal="10dp"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="विद्यार्थी का नाम (हिन्दी में)"
                    android:textColor="@color/accent_sky"
                    android:textSize="11sp"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/etAddNameHindi"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:hint="राहुल कुमार शर्मा"
                    android:textColor="@color/accent_sky"
                    android:textColorHint="@color/text_muted"
                    android:background="#071224"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <!-- Date of Birth & Gender -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Date of Birth *"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnDobPicker"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:gravity="center_vertical"
                            android:text="Select DOB 📅"
                            android:textColor="@color/text_light"
                            android:background="#071224"
                            android:paddingHorizontal="10dp"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gender *"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <Spinner
                            android:id="@+id/spAddGender"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:background="#071224"
                            android:paddingHorizontal="6dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Caste Category & Blood Group -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Category (जाति वर्ग)"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <Spinner
                            android:id="@+id/spAddCategory"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:background="#071224"
                            android:paddingHorizontal="6dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Blood Group"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <Spinner
                            android:id="@+id/spAddBloodGroup"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:background="#071224"
                            android:paddingHorizontal="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- SECTION 3: Parents & Contacts -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Parents &amp; Contacts"
                android:textColor="@color/accent_sky"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="12dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Father's Name (English)"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etAddFatherName"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:hint="Father Full Name"
                    android:textColor="@color/text_light"
                    android:textColorHint="@color/text_muted"
                    android:background="#071224"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="पिता का नाम (हिन्दी)"
                    android:textColor="@color/accent_sky"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etAddFatherHindi"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:hint="पिता का नाम"
                    android:textColor="@color/accent_sky"
                    android:textColorHint="@color/text_muted"
                    android:background="#071224"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mother's Name (English)"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etAddMotherName"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:hint="Mother Full Name"
                    android:textColor="@color/text_light"
                    android:textColorHint="@color/text_muted"
                    android:background="#071224"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="माता का नाम (हिन्दी)"
                    android:textColor="@color/accent_sky"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etAddMotherHindi"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:hint="माता का नाम"
                    android:textColor="@color/accent_sky"
                    android:textColorHint="@color/text_muted"
                    android:background="#071224"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mobile Number (WhatsApp &amp; SMS) *"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etAddMobile"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:hint="10-digit primary mobile"
                    android:inputType="phone"
                    android:textColor="@color/text_light"
                    android:textColorHint="@color/text_muted"
                    android:background="#071224"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- SECTION 4: Government IDs & Address -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. Government IDs &amp; Residence"
                android:textColor="@color/accent_sky"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="12dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Samagra Member ID (9-Digit SSSMID)"
                    android:textColor="@color/success_green"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etAddSssmid"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:hint="9 Digits Samagra ID"
                    android:inputType="number"
                    android:maxLength="9"
                    android:textColor="@color/success_green"
                    android:textColorHint="@color/text_muted"
                    android:background="#071224"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aadhaar Card Number (12-Digit UIDAI)"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etAddAadhaar"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:hint="12 Digits Aadhaar"
                    android:inputType="number"
                    android:maxLength="12"
                    android:textColor="@color/text_light"
                    android:textColorHint="@color/text_muted"
                    android:background="#071224"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Village / Town (ग्राम / शहर)"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etAddVillage"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:hint="e.g. Umari / Lahar"
                    android:textColor="@color/text_light"
                    android:textColorHint="@color/text_muted"
                    android:background="#071224"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full Address (पूरा पता)"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etAddAddress"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:hint="House No, Ward, Street..."
                    android:textColor="@color/text_light"
                    android:textColorHint="@color/text_muted"
                    android:background="#071224"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- SECTION 5: Previous School & Bank -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5. Previous School &amp; Bank Details"
                android:textColor="@color/accent_sky"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="12dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Previous School Name"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etAddPrevSchool"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:hint="Previous School Name"
                    android:textColor="@color/text_light"
                    android:textColorHint="@color/text_muted"
                    android:background="#071224"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bank Account Number"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etAddBankAccount"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:hint="Student / Parent Bank A/C"
                    android:textColor="@color/text_light"
                    android:textColorHint="@color/text_muted"
                    android:background="#071224"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bank Name"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etAddBankName"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:hint="e.g. SBI"
                            android:textColor="@color/text_light"
                            android:textColorHint="@color/text_muted"
                            android:background="#071224"
                            android:paddingHorizontal="10dp"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IFSC Code"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etAddIfsc"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:hint="SBIN0001234"
                            android:textColor="@color/text_light"
                            android:textColorHint="@color/text_muted"
                            android:background="#071224"
                            android:paddingHorizontal="10dp"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnSubmitAdmission"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="🎓 Register &amp; Save Student"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_primary"
                android:layout_marginBottom="30dp" />

            <ProgressBar
                android:id="@+id/pbAddStudent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
