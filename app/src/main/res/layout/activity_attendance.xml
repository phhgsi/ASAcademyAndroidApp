<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@color/bg_card"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBackAttendance"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Attendance Register"
                android:textColor="@color/text_light"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAttendanceSubHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Class &amp; Date"
                android:textColor="@color/accent_sky"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnPickDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today 📅"
            android:textColor="@color/accent_sky"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_chip_selected" />
    </LinearLayout>

    <!-- Horizontal Class Selection Chips -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAttendanceClasses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        android:paddingHorizontal="10dp"
        android:clipToPadding="false"
        android:background="@color/bg_dark" />

    <!-- Summary & Bulk Actions Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:background="#0B1E38">

        <TextView
            android:id="@+id/tvAttendanceCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 Students"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMarkAllPresent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mark All Present"
            android:textColor="@color/success_green"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_chip_selected"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnMarkAllAbsent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All Absent"
            android:textColor="@color/danger_red"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_chip_selected" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbAttendance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:visibility="gone" />

    <!-- Main Student Attendance List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAttendanceStudents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp"
        android:clipToPadding="false" />

    <!-- Bottom Submit Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:padding="12dp">

        <Button
            android:id="@+id/btnSaveAttendance"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="💾 Save &amp; Submit Attendance"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_primary" />
    </LinearLayout>

</LinearLayout>
