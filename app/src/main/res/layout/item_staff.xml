<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_dark">

    <!-- Avatar Icon -->
    <TextView
        android:id="@+id/tvStaffAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="👨‍🏫"
        android:textSize="20sp"
        android:background="@drawable/bg_chip_selected"
        android:layout_marginEnd="12dp" />

    <!-- Staff Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStaffName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Teacher Full Name"
            android:textColor="@color/text_light"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStaffDesignation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Senior Teacher • Mathematics"
            android:textColor="@color/accent_sky"
            android:textSize="11.5sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvStaffMobile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+91 9876543210"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Call & WhatsApp Action Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnCallStaff"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_call"
            android:background="@drawable/bg_chip_selected"
            android:layout_marginEnd="6dp"
            android:contentDescription="Call" />

        <TextView
            android:id="@+id/btnWhatsappStaff"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="💬"
            android:textSize="16sp"
            android:background="@drawable/bg_chip_selected"
            android:contentDescription="WhatsApp" />
    </LinearLayout>

</LinearLayout>
